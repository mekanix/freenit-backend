# Copy this file to /usr/local/etc/gunicorn/freenit.env and adjust values.
# It is loaded by gunicorn.conf.py at startup.

FREENIT_ENV=production
FREENIT_SECRET_KEY=change-me-to-a-long-random-string
FREENIT_DBURL=postgresql+asyncpg://user:password@localhost/freenit

# Optional gunicorn overrides
# GUNICORN_BIND=127.0.0.1:5000
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
